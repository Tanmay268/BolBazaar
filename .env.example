# Runtime
APP_ENV=development                # development seeds demo data; anything else requires JWT_SECRET
HOST=0.0.0.0
PORT=8000
APP_BASE_URL=http://127.0.0.1:8000
CORS_ORIGINS=http://localhost:5173,http://localhost,https://localhost,capacitor://localhost
SEED_DEMO_DATA=true                # only honoured when APP_ENV=development

# Providers. offline needs no keys. speech/reasoner can be switched independently.
PROVIDER_MODE=offline              # offline | live
SPEECH_MODE=                       # optional override: offline | live
REASONER_MODE=                     # optional override: offline | live

# Database (SQLite by default; use Postgres for deployment: pip install ".[postgres]")
DATABASE_URL=sqlite:///./data/fieldforce.db
# DATABASE_URL=postgresql+psycopg://fieldforce:change_me@localhost:5432/fieldforce

# Auth
JWT_SECRET=                        # required outside development; use 32+ random bytes
JWT_TTL_MINUTES=720

# Gnani (server-side only). Language-specific STT format and TTS voice live in domain/languages.py
GNANI_API_KEY=
GNANI_BASE_URL=https://api.vachana.ai
GNANI_STT_MODEL=prisma-v3.0
GNANI_TIMEOUT_MS=25000
GNANI_MAX_RETRIES=2
GNANI_MAX_SEGMENT_SECONDS=28       # STT REST cap is 30 s
GNANI_MAX_CONCURRENT_REQUESTS=1    # default account limit
GNANI_DAILY_CALL_BUDGET=200        # hard stop to protect credits
GNANI_TTS_MODEL=                   # optional override of the per-language profile (timbre-v2.5 | timbre-v3.0)
GNANI_TTS_VOICE=                   # optional override; voices differ per model
GNANI_TTS_SPEED=1.0                # 0.85 - 1.15

# Azure OpenAI (extraction and reasoning)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_TIMEOUT_MS=30000
AZURE_OPENAI_MAX_RETRIES=2

# Audio storage and limits
AUDIO_STORAGE_DIR=./data/audio
AUDIO_RETENTION_HOURS=24
MAX_AUDIO_BYTES=15728640
MAX_AUDIO_SECONDS=120
