# Runtime
APP_ENV=development                # development seeds demo data; anything else requires JWT_SECRET
HOST=0.0.0.0
PORT=8000
APP_BASE_URL=http://127.0.0.1:8000
CORS_ORIGINS=http://localhost:5173,http://localhost,https://localhost,capacitor://localhost
SEED_DEMO_DATA=true                # only honoured when APP_ENV=development

# Providers. offline needs no keys. speech/reasoner can be switched independently.
PROVIDER_MODE=offline              # offline | live
SPEECH_MODE=                       # optional override: offline | live
REASONER_MODE=                     # optional override: offline | live

# Database (SQLite by default; use Postgres for deployment: pip install ".[postgres]")
DATABASE_URL=sqlite:///./data/bolbazaar.db
# DATABASE_URL=postgresql+psycopg://bolbazaar:change_me@localhost:5432/bolbazaar

# Auth
JWT_SECRET=                        # required outside development; use 32+ random bytes
JWT_TTL_MINUTES=720

# Self-service sign-up. Managers must enter MANAGER_SIGNUP_CODE; empty disables manager sign-up.
ALLOW_SIGNUP=true
MANAGER_SIGNUP_CODE=

# Gnani (server-side only). Language-specific STT format and TTS voice live in domain/languages.py
GNANI_API_KEY=
GNANI_BASE_URL=https://api.vachana.ai
GNANI_STT_MODEL=prisma-v3.0
GNANI_TIMEOUT_MS=25000
GNANI_MAX_RETRIES=2
GNANI_MAX_SEGMENT_SECONDS=28       # STT REST cap is 30 s
GNANI_MAX_CONCURRENT_REQUESTS=1    # default account limit
GNANI_DAILY_CALL_BUDGET=200        # hard stop to protect credits
GNANI_TTS_MODEL=                   # optional override of the per-language profile (timbre-v2.5 | timbre-v3.0)
GNANI_TTS_VOICE=                   # optional override; voices differ per model
GNANI_TTS_SPEED=1.0                # 0.85 - 1.15

# Azure OpenAI (extraction and reasoning)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_TIMEOUT_MS=30000
AZURE_OPENAI_MAX_RETRIES=2

# Audio storage and limits
AUDIO_STORAGE_DIR=./data/audio
AUDIO_RETENTION_HOURS=24
MAX_AUDIO_BYTES=15728640
MAX_AUDIO_SECONDS=120

# ---------------------------------------------------------------------------------------------------------------
# Cost protection and abuse limits (see security/CREDIT_PROTECTION_REPORT.md). A limit of 0 BLOCKS the operation.
# ---------------------------------------------------------------------------------------------------------------
# Emergency switches (restart needed). At runtime an admin can also call PUT /v1/admin/providers/{gnani|azure|all}.
AI_SERVICES_ENABLED=true
GNANI_ENABLED=true
AZURE_ENABLED=true

# Sign-up. Set REP_SIGNUP_CODE to stop strangers creating accounts that can spend credits.
REP_SIGNUP_CODE=
SIGNUP_GLOBAL_PER_DAY=300
# Password for seeded demo accounts. The default (demo123) is public: set this on any shared deployment.
DEMO_PASSWORD=demo123
# Serve /docs and /openapi.json (default: only when APP_ENV=development).
EXPOSE_DOCS=

# Reverse proxies in front of the app (Render = 1). 0 = ignore X-Forwarded-For. Wrong values break per-IP limits.
TRUSTED_PROXY_COUNT=0

# Per-user limits (UTC fixed windows). stt = Gnani speech-to-text calls; llm = Azure OpenAI calls; tts = Gnani speech.
USER_STT_PER_MINUTE=8
USER_STT_PER_HOUR=60
USER_STT_PER_DAY=120
USER_STT_AUDIO_SECONDS_PER_DAY=3600
USER_TTS_PER_MINUTE=6
USER_TTS_PER_HOUR=40
USER_TTS_PER_DAY=80
USER_TTS_CHARS_PER_DAY=15000
USER_LLM_PER_MINUTE=12
USER_LLM_PER_HOUR=100
USER_LLM_PER_DAY=250
USER_LLM_EST_TOKENS_PER_DAY=400000
USER_MAX_CONCURRENT_AI=2
MAX_PROCESS_ATTEMPTS_PER_CAPTURE=4

# Global ceilings across all users (shared through the database). Gnani requests/day = GNANI_DAILY_CALL_BUDGET.
GLOBAL_GNANI_PER_MINUTE=30
GLOBAL_GNANI_AUDIO_SECONDS_PER_DAY=7200
GLOBAL_GNANI_TTS_CHARS_PER_DAY=60000
GLOBAL_AZURE_PER_MINUTE=60
GLOBAL_AZURE_REQUESTS_PER_DAY=800
GLOBAL_AZURE_EST_TOKENS_PER_DAY=1500000
AZURE_DAILY_CALL_BUDGET=2400
AZURE_MAX_OUTPUT_TOKENS=2048
AZURE_MAX_CONCURRENT_REQUESTS=4

# Input limits and request rate limits
MAX_TRANSCRIPT_CHARS=4000
MAX_CORRECTION_CHARS=500
MAX_TTS_CHARS=600
MAX_JSON_BODY_BYTES=262144
RL_IP_PER_MINUTE=240
RL_USER_PER_MINUTE=120
RL_LOGIN_IP_PER_MINUTE=20
RL_LOGIN_FAILURES_PER_ACCOUNT=8
RL_LOGIN_FAILURES_PER_IP=30
RL_REGISTER_IP_PER_HOUR=5

# Circuit breaker
BREAKER_FAILURE_THRESHOLD=5
BREAKER_COOLDOWN_SECONDS=60
BREAKER_FATAL_COOLDOWN_SECONDS=900

# Catalogue
USER_PRODUCTS_PER_DAY=60
MAX_PRODUCTS=500
USER_BULK_PRODUCTS_PER_DAY=300
MAX_CATALOGUE_TEXT_CHARS=6000
MAX_CATALOGUE_DRAFT_ITEMS=100

# Bug reports
USER_BUG_REPORTS_PER_DAY=10
GLOBAL_BUG_REPORTS_PER_DAY=500
