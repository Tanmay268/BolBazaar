# ---- BolBazaar Demo Studio. Copy to .env (never commit .env) ----------------------------------
# Environment. By default the studio starts its OWN isolated backend + web dev server with a throw-away
# SQLite DB under demo-studio/.runtime, so no real or shared data is touched.
DEMO_MANAGE_ENV=true                 # true = start/stop isolated backend (port 8100) + web (port 5273)
DEMO_WEB_URL=http://127.0.0.1:5273   # web app under recording
DEMO_API_URL=http://127.0.0.1:8100   # API used by that web app
DEMO_ALLOW_REMOTE=false              # must be true to point at anything that is not localhost/127.0.0.1

# Provider mode of the managed backend: offline (no paid calls, STT is a stub) | live (Gnani STT/TTS + Azure OpenAI)
DEMO_PROVIDER_MODE=offline
# Live mode spends real credits and loads GNANI_*/AZURE_* from ../backend/.env. Both must be set to use it.
DEMO_ALLOW_PAID_APIS=false
DEMO_MAX_PAID_CALLS=12               # hard ceiling of live STT+LLM+TTS calls the studio will trigger per run

# Demo accounts (seeded development accounts; override when using your own staging data)
DEMO_REP_USER=asha
DEMO_REP_PASSWORD=demo123
DEMO_MANAGER_USER=meera
DEMO_MANAGER_PASSWORD=demo123

# Narration. provider: edge (free Microsoft neural voices, no key) | elevenlabs | sapi (offline Windows voice) | none
TTS_PROVIDER=edge
EDGE_VOICE=en-IN-NeerjaExpressiveNeural
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2
TTS_MAX_CHARS_PER_RUN=2500           # spending/request guard for any paid TTS
TTS_MAX_REQUESTS_PER_RUN=12

# Output
DEMO_WEBSITE_URL=
DEMO_HEADED=false                    # true = visible browser while recording
DEMO_DEBUG=false                     # true = screenshots + verbose logs in artifacts/demo/debug
